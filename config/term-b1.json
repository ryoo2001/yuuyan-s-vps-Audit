{
  "db": "/var/lib/traffic-audit/audit.sqlite",
  "health": "/var/lib/traffic-audit/health.json",
  "retention_days": 7,
  "mode": "terminal",
  "node": "term-b1",
  "max_db_mb": 512,
  "sample_interval": 0.5,
  "mihomo_config": "/etc/mihomo/config.yaml",
  "inbound_ports": [
    28960,
    28900,
    2101,
    24443
  ],
  "captures": [
    {
      "interface": "eth0",
      "tcp_ports": [
        28960,
        28900,
        2101,
        24443
      ],
      "udp_ports": [
        28960,
        28900,
        2101
      ]
    }
  ],
  "listen": [
    "203.0.113.107"
  ],
  "udp_listen": [],
  "peers": {
    "entry-b1": {
      "auth_file": "/etc/traffic-audit/entry-b1-auth.toml",
      "tcp_ports": [
        28960
      ],
      "udp_ports": [
        28960
      ]
    },
    "entry-b2": {
      "auth_file": "/etc/traffic-audit/entryb2-entrya-auth.toml",
      "tcp_ports": [
        28900,
        443
      ],
      "udp_ports": [
        28900
      ]
    },
    "entry-a1": {
      "auth_file": "/etc/traffic-audit/entrya2101-auth.toml",
      "tcp_ports": [
        2101
      ],
      "udp_ports": [
        2101
      ]
    }
  },
  "entry_routes": [
    {
      "node": "entry-b1",
      "inbound_port": 28960,
      "tunnel_ip": "203.0.113.112"
    },
    {
      "node": "entry-b2",
      "inbound_port": 28900,
      "tunnel_ip": "203.0.113.111"
    },
    {
      "node": "entry-a1",
      "inbound_port": 2101,
      "tunnel_ip": "203.0.113.114"
    },
    {
      "node": "entry-b2",
      "inbound_port": 24443,
      "tunnel_ip": "203.0.113.111"
    }
  ],
  "archive_node": "center-host",
  "local_cache_hours": 24,
  "exclusive_ingress": [],
  "inbound_types": {
    "2101": [
      "ShadowSocks"
    ],
    "24443": [
      "AnyTLS"
    ]
  },
  "fingerprint_routes": [
    {
      "node": "entry-b1",
      "inbound_port": 28960,
      "entry_port": 28960,
      "transport": "tcp"
    },
    {
      "node": "entry-b1",
      "inbound_port": 28960,
      "entry_port": 28960,
      "transport": "udp"
    },
    {
      "node": "entry-b2",
      "inbound_port": 28900,
      "entry_port": 28900,
      "transport": "tcp"
    },
    {
      "node": "entry-b2",
      "inbound_port": 28900,
      "entry_port": 28900,
      "transport": "udp"
    },
    {
      "node": "entry-a1",
      "inbound_port": 2101,
      "entry_port": 2101,
      "transport": "tcp"
    },
    {
      "node": "entry-a1",
      "inbound_port": 2101,
      "entry_port": 2101,
      "transport": "udp"
    },
    {
      "node": "entry-b2",
      "inbound_port": 24443,
      "entry_port": 443,
      "transport": "tcp"
    }
  ]
}
