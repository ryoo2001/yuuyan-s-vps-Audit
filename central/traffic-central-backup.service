[Unit]
Description=Logical backup of the audit databases to term-c-host
After=mariadb.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/libexec/traffic-central-storage/backup.sh
Nice=15
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=160M
TimeoutStartSec=1h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/traffic-central/state
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
