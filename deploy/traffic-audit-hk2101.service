[Unit]
Description=Passive audit hk2101 client-facing capture
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/traffic-audit-links/edge_front.py --config /etc/traffic-audit/hk2101.json
Restart=on-failure
RestartSec=5
User=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/traffic-audit
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK AF_PACKET
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=128M
CPUQuota=30%
TasksMax=24
TimeoutStopSec=15
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
