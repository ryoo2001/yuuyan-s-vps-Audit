[Unit]
Description=Send entrya 2101 audit batches through hk database
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/traffic-audit-links/edge_queue.py sender --config /etc/traffic-audit/termb4-queue.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
Environment=PYTHONPATH=/usr/local/libexec/traffic-audit-pymysql.zip

[Install]
WantedBy=multi-user.target
