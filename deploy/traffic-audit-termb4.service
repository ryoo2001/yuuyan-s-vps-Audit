[Unit]
Description=Passive term-b4 traffic audit
After=network-online.target mihomo.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/traffic-audit/audit.py --config /etc/traffic-audit/termb4.json
Restart=on-failure
RestartSec=5
User=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/traffic-audit
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=160M
CPUQuota=50%
TasksMax=32
TimeoutStopSec=15
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
