[Unit]
Description=Passive ENTRYB2 edge traffic audit
After=network-online.target traffic-audit-entryb2-tunnel.service
Wants=network-online.target traffic-audit-entryb2-tunnel.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/traffic-audit/edge_front.py --config /etc/traffic-audit/config.json
Restart=on-failure
RestartSec=5
User=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/traffic-audit
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK AF_PACKET
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=112M
CPUQuota=30%
TasksMax=24
TimeoutStopSec=15
Environment=PYTHONDONTWRITEBYTECODE=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
