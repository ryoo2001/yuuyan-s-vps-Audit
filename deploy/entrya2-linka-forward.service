[Unit]
Description=LINKA layer 4 ingress forwarding for TCP/UDP 28600
After=network-online.target ufw.service
Wants=network-online.target
Requires=ufw.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/sbin/nft delete table ip entrya2_linka
ExecStart=/usr/sbin/nft -f /etc/nftables.d/entrya2-linka.nft
ExecReload=/bin/sh -ec '/usr/sbin/nft delete table ip entrya2_linka 2>/dev/null || true; exec /usr/sbin/nft -f /etc/nftables.d/entrya2-linka.nft'
ExecStop=-/usr/sbin/nft delete table ip entrya2_linka
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
